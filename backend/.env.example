## Backend environment variables
##
## Copy to backend/.env (or set in your hosting environment)

# Required in production: secret used to sign JWT tokens
SECRET_KEY=change-me

# Optional
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# S3 / Backblaze B2 (optional - only needed for photo upload)
# S3_BUCKET_NAME=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto
# S3_ENDPOINT_URL=
# S3_KEY_PREFIX=item_photos
#
# Public URLs (optional)
# BACKEND_PUBLIC_URL=http://localhost:8000
# FRONTEND_PUBLIC_URL=http://localhost:5173
