# ============================================================
# ПРИМЕР ПЕРЕМЕННЫХ ОКРУЖЕНИЯ
# Скопируйте в .env для локальной разработки.
# На Railway те же переменные задаются в Variables сервиса.
# Файл .env в git не коммитится.
# ============================================================

# --- Безопасность ---
# Обязательно задайте свой ключ. Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- База данных ---
# Connection string из Supabase: Project Settings -> Database -> Connection string -> URI
# Если не задать, приложение поднимется на локальном SQLite (backend/inventory.db)
DATABASE_URL=

# --- Публичные адреса ---
# Домен фронтенда (Vercel). Используется для CORS и для ссылок внутри QR-кодов.
FRONTEND_PUBLIC_URL=https://your-app.vercel.app
# Домен бэкенда на Railway. Нужен для ссылок на фото, если bucket приватный.
BACKEND_PUBLIC_URL=https://your-app.up.railway.app
# Дополнительные разрешённые источники для CORS, через запятую (необязательно)
CORS_ORIGINS=

# --- Supabase Storage (фотографии мебели) ---
# Project Settings -> API -> Project URL
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Project Settings -> API -> service_role secret. НИКОГДА не публикуйте во фронтенде.
SUPABASE_SERVICE_KEY=
# Имя bucket, созданного в Storage
SUPABASE_BUCKET=furniture-photos
# true — фото раздаются напрямую через CDN Supabase (быстрее, рекомендуется)
# false — фото идут через бэкенд по адресу /furniture/photo-proxy/...
SUPABASE_BUCKET_PUBLIC=true
# Папка внутри bucket
SUPABASE_KEY_PREFIX=item_photos
# Максимальный размер загружаемого фото в мегабайтах
MAX_PHOTO_SIZE_MB=10

# ============================================================
# ЛЕГАСИ: старое хранилище S3 / Backblaze B2.
# Заполняйте ТОЛЬКО если в базе ещё остались фото со старыми ссылками.
# Используется в режиме «только чтение» и скриптом миграции.
# После переноса всех фото эти переменные можно удалить.
# ============================================================
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=
S3_REGION=auto
S3_KEY_PREFIX=item_photos
S3_PUBLIC_BASE_URL=
